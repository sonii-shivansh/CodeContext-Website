---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductLoop from '../components/ProductLoop.astro';
const base = import.meta.env.BASE_URL;

const capabilities = [
  ['Repository Intelligence', 'Java/Kotlin discovery, parsing, configurable exclusions, parallel analysis, caching, and self-contained HTML reporting.'],
  ['Dependency & Graph Intelligence', 'Dependency graphs, wildcard imports, cycles, connected components, PageRank knowledge hotspots, and learning paths.'],
  ['Git & Evolution', 'Authorship, churn, modification time, recent changes, time-based commit sampling, and source-history hotspots.'],
  ['Change & PR Intelligence', 'Dependency-aware impact, blast-radius signals, change-size/risk signals, architecture findings, tests, and machine-readable artifacts.'],
  ['Architecture Governance', 'Architecture findings, drift against an explicit baseline, deterministic contracts, severity/finding/cycle limits, and decision records.'],
  ['Engineering Context & Reality', 'Versioned snapshots, repository fingerprints, Git HEAD binding, context diffs, and deterministic Reality identity.'],
  ['Grounded Repository Q&A', 'Intent-aware retrieval, bounded evidence, deterministic ranking, citations, and explicit insufficient-evidence handling.'],
  ['Engineering Planner', 'Read-only, evidence-backed implementation plans with affected components, risks, steps, verification criteria, and uncertainty.'],
  ['Agent Change Contract', 'A persisted repository-bound change boundary with planned paths, evidence, verification, architecture expectations, and SHA-256 fingerprint.'],
  ['Prepare → Change → Verify', 'Prepare before implementation and verify the original persisted contract after the change; tampering and stale state are detectable.'],
  ['CLI · REST · MCP', 'The same intelligence is available through the CLI, local Ktor REST API, and local MCP stdio integration.'],
  ['Optional AI', 'Gemini/Anthropic assistance can reason over bounded repository-derived context; AI is disabled unless explicitly configured.']
];
---

<BaseLayout title="Vericore — Evidence-grounded engineering intelligence" description="Vericore 0.7.0 provides deterministic engineering intelligence for Java and Kotlin repositories, grounded evidence, Engineering Reality, change safety, architecture governance, local APIs, MCP, and optional AI assistance.">
  <section class="hero container">
    <div class="eyebrow"><span class="pulse"></span> v0.7.0 · stable · open source · local-first</div>
    <h1>Understand.<br /><span>Change. Verify.</span></h1>
    <p class="hero-copy">Vericore turns repository structure, Git history, architecture, and changes into reproducible engineering intelligence. Evidence flows into Q&amp;A and planning, then into a persisted Agent Change Contract that can be verified after implementation.</p>
    <div class="actions"><a class="button primary" href="https://github.com/sonii-shivansh/Vericore">View on GitHub ↗</a><a class="button secondary" href="#proof">Explore the proof</a><a class="button secondary" href="https://github.com/sonii-shivansh/Vericore/releases/tag/v0.7.0">Get v0.7.0 ↗</a></div>
    <div class="terminal" aria-label="Example Vericore workflow output"><div class="terminal-bar"><span></span><span></span><span></span><strong>vericore 0.7.0</strong></div><pre><code><span class="dim">$</span> vericore analyze ./payment-service
<span class="ok">✓</span> Repository indexed             <b>428 files</b>
<span class="ok">✓</span> Dependency relationships        <b>1,284</b>
<span class="ok">✓</span> Knowledge hotspots              <b>12</b>
<span class="ok">✓</span> Engineering Reality             <b>bound</b>

<span class="accent">Grounded evidence</span>
  E17  PaymentService → PaymentRepository
  E21  PaymentController → PaymentService
  E34  recent fraud-flow history

<span class="accent">Safety boundary</span>
  prepare → Agent Change Contract → change → verify</code></pre></div>
  </section>

  <section class="section container"><ProductLoop /></section>

  <section id="capabilities" class="section container"><div class="section-heading"><span class="kicker">01 / WHAT SHIPS</span><h2>More than code analysis.</h2><p>Vericore 0.7.0 connects deterministic repository facts to engineering workflows. These are shipped capabilities, not roadmap promises.</p></div><div class="capability-grid">{capabilities.map(([title, description], index) => (<article class="capability-card"><span class="index">{String(index + 1).padStart(2, '0')}</span><h3>{title}</h3><p>{description}</p></article>))}</div></section>

  <section id="architecture" class="section container"><div class="section-heading"><span class="kicker">02 / TRUST MODEL</span><h2>Deterministic evidence first. Reasoning second.</h2><p>Repository-derived facts establish the evidence boundary. Engineering Context and Engineering Reality bind that evidence to repository state. Higher-level workflows consume the boundary; optional AI adds reasoning without becoming repository truth.</p></div><div class="flow" aria-label="Vericore processing flow"><div>Repository + Git</div><i>→</i><div>Analysis</div><i>→</i><div>Context</div><i>→</i><div>Reality</div><i>→</i><div>Evidence</div><i>→</i><div>Q&amp;A / Plan / Verify</div></div><div class="architecture-grid"><article><span class="kicker">STATE</span><h3>Engineering Reality</h3><p>Combines analysis and repository-context identity so stale analysis can be rejected rather than silently mixed with newer source state.</p></article><article><span class="kicker">GOVERNANCE</span><h3>Architecture contracts</h3><p>Explicit baselines and contracts can turn architecture findings, cycles, and severity limits into deterministic CI decisions and records.</p></article><article><span class="kicker">SAFETY</span><h3>Agent Change Contract</h3><p>The persisted prepare contract binds paths, evidence, verification, architecture expectations, and repository identity. Verify checks that original artifact.</p></article></div></section>

  <section id="proof" class="section container proof"><div class="section-heading"><span class="kicker">03 / PROOF</span><h2>From repository facts to a bounded engineering change.</h2><p>Follow the same conceptual path represented by the CLI and local APIs: analyze, establish Reality, retrieve evidence, plan, persist the change boundary, then verify.</p></div><div class="proof-grid"><article><span>01</span><strong>Analyze</strong><p>Generate repository, dependency, Git, architecture, and report artifacts.</p></article><article><span>02</span><strong>Ground</strong><p>Retrieve bounded evidence for impact, risk, architecture, PR, or test questions.</p></article><article><span>03</span><strong>Prepare</strong><p>Create the engineering plan and repository-bound Agent Change Contract.</p></article><article><span>04</span><strong>Verify</strong><p>Check the persisted contract against the post-change repository state.</p></article></div><a class="text-link" href={`${base}demo/`}>Open the interactive proof ↗</a></section>

  <section class="section container launch"><div class="section-heading"><span class="kicker">04 / LOCAL-FIRST</span><h2>Run it where your code already lives.</h2><p>Released archives bundle a Java runtime. Vericore can also be built from source. The local REST server is intended for trusted local/internal use, and MCP is a trusted local agent integration.</p></div><div class="launch-grid"><article><span class="kicker">PLATFORMS</span><strong>Linux x64 · Windows x64 · macOS x64 · macOS ARM64</strong></article><article><span class="kicker">INTERFACES</span><strong>CLI · local REST · MCP stdio · HTML reports</strong></article><article><span class="kicker">AI</span><strong>Optional Gemini/Anthropic assistance over bounded context</strong></article><article><span class="kicker">OUTPUT</span><strong>JSON artifacts · snapshots · evidence · plans · contracts · reports</strong></article></div></section>

  <section class="cta container"><div><span class="kicker">OPEN SOURCE</span><h2>Inspect the implementation.</h2><p>Read the code, contracts, documentation, release artifacts, and verification workflows behind Vericore 0.7.0.</p></div><a class="button primary" href="https://github.com/sonii-shivansh/Vericore">Open repository ↗</a></section>
</BaseLayout>

<style>
.hero{padding:112px 0 40px;position:relative}.hero::before{content:'';position:absolute;inset:0 -30vw auto;height:520px;z-index:-1;background:radial-gradient(circle at 50% 30%,rgb(115 213 255 / 10%),transparent 48%);pointer-events:none}.eyebrow,.kicker{color:var(--accent);font:600 .72rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.12em;text-transform:uppercase}.eyebrow{display:flex;align-items:center;gap:9px;margin-bottom:26px}.pulse{width:7px;height:7px;border-radius:50%;background:var(--success);box-shadow:0 0 14px rgb(110 231 183 / 70%)}h1{max-width:900px;margin:0;font-size:clamp(3.2rem,8vw,6.8rem);line-height:.96;letter-spacing:-.065em}h1 span{color:var(--muted)}.hero-copy{max-width:800px;margin:30px 0;color:var(--muted);font-size:clamp(1rem,2vw,1.25rem)}.actions{display:flex;gap:12px;flex-wrap:wrap}.button{display:inline-flex;min-height:44px;align-items:center;justify-content:center;padding:0 18px;border-radius:8px;text-decoration:none;font-weight:650;font-size:.9rem}.primary{background:var(--text);color:var(--bg)}.secondary{border:1px solid var(--line);background:var(--panel)}.terminal{margin-top:72px;border:1px solid var(--line);border-radius:12px;background:#080c12;box-shadow:0 30px 80px rgb(0 0 0 / 30%);overflow:hidden}.terminal-bar{height:42px;display:flex;align-items:center;gap:7px;padding:0 14px;border-bottom:1px solid var(--line);color:var(--muted);font:.72rem ui-monospace,SFMono-Regular,Menlo,monospace}.terminal-bar span{width:8px;height:8px;border-radius:50%;background:var(--line)}.terminal-bar strong{margin-left:8px;font-weight:500}pre{margin:0;padding:28px;overflow-x:auto;color:#cbd5e1;font:.82rem/1.8 ui-monospace,SFMono-Regular,Menlo,monospace}.dim{color:var(--muted)}.ok{color:var(--success)}.accent{color:var(--accent)}.section{padding-top:120px}.section-heading{max-width:820px;margin-bottom:42px}.section-heading h2,.cta h2{margin:10px 0;font-size:clamp(2rem,4vw,3.4rem);line-height:1.05;letter-spacing:-.04em}.section-heading p,.cta p{color:var(--muted);max-width:720px}.capability-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.capability-card,.architecture-grid article,.proof-grid article,.launch-grid article{border:1px solid var(--line);background:var(--panel);border-radius:10px}.capability-card{min-height:200px;padding:22px}.index{color:var(--muted);font:.72rem ui-monospace,SFMono-Regular,Menlo,monospace}h3{margin:28px 0 8px;font-size:1rem}.capability-card p,.architecture-grid p,.proof-grid p,.launch-grid strong{margin:0;color:var(--muted);font-size:.88rem}.flow{display:flex;align-items:center;justify-content:center;gap:10px;flex-wrap:wrap;padding:32px;border:1px solid var(--line);background:var(--panel);border-radius:10px;font:.76rem ui-monospace,SFMono-Regular,Menlo,monospace}.flow div{padding:10px 14px;border:1px solid var(--line);border-radius:7px;background:var(--panel-2)}.flow i{color:var(--accent);font-style:normal}.architecture-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:10px}.architecture-grid article{padding:24px}.architecture-grid h3{margin-top:18px}.proof-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.proof-grid article{padding:24px}.proof-grid span{color:var(--accent);font:.72rem ui-monospace,monospace}.proof-grid strong{display:block;margin:18px 0 8px}.text-link{display:inline-block;margin-top:18px;color:var(--accent);text-underline-offset:4px}.launch{padding-bottom:20px}.launch-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.launch-grid article{padding:22px}.launch-grid strong{display:block;margin-top:14px;line-height:1.5}.cta{margin-top:120px;padding:38px;display:flex;align-items:center;justify-content:space-between;gap:30px;border:1px solid var(--line);border-radius:12px;background:linear-gradient(120deg,var(--panel),#0b1018)}
@media(max-width:1000px){.capability-grid{grid-template-columns:repeat(2,1fr)}.architecture-grid,.proof-grid,.launch-grid{grid-template-columns:1fr 1fr}.architecture-grid article:last-child,.proof-grid article:last-child,.launch-grid article:last-child{grid-column:1/-1}}
@media(max-width:700px){.hero{padding-top:78px}.section{padding-top:88px}.capability-grid,.architecture-grid,.proof-grid,.launch-grid{grid-template-columns:1fr}.architecture-grid article:last-child,.proof-grid article:last-child,.launch-grid article:last-child{grid-column:auto}.flow{justify-content:flex-start;overflow-x:auto;flex-wrap:nowrap;padding:20px}.flow i{flex:0 0 auto}.cta{margin-top:88px;flex-direction:column;align-items:flex-start;padding:26px}.terminal{margin-top:48px}.hero-copy{margin-block:22px}.actions{width:100%}.actions .button{flex:1 1 180px}}
@media(max-width:430px){h1{font-size:clamp(2.55rem,14vw,3.5rem)}.container{width:calc(100% - 24px)}.section-heading h2,.cta h2{font-size:2rem}.capability-card,.architecture-grid article,.proof-grid article,.launch-grid article{padding:20px}.button{width:100%}}
</style>
