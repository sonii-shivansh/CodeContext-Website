---
import BaseLayout from '../layouts/BaseLayout.astro';

const capabilities = [
  ['01', 'Repository Intelligence', 'Java and Kotlin discovery and parsing with configurable exclusions, file limits, parallel parsing, content-based caching, and self-contained HTML reports.'],
  ['02', 'Dependency & Graph Intelligence', 'Dependency relationships, wildcard-import handling, connected components, cycle detection, PageRank knowledge hotspots, and learning-path generation.'],
  ['03', 'Git & Evolution', 'Authorship, churn, modification time, recent changes, deterministic time-based commit sampling, source-history metrics, and evolution hotspots.'],
  ['04', 'Change Impact', 'Reverse-dependency traversal combines graph depth, PageRank, churn, and package signals to expose affected areas and test candidates.'],
  ['05', 'PR Intelligence', 'Structured pull-request change context including change size, risk signals, architecture findings, test recommendations, and machine-readable artifacts.'],
  ['06', 'Architecture Intelligence', 'Architecture relationships, cycles, drift against explicit baselines, deterministic contracts, severity limits, and decision records.'],
  ['07', 'Engineering Context', 'Versioned snapshots, repository-relative fingerprints, stable digests, Git HEAD capture, dirty-state information, and snapshot diffs.'],
  ['08', 'Engineering Reality', 'Deterministically composes analysis and repository context so stale analysis can be rejected instead of silently mixed with newer source state.'],
  ['09', 'Grounded Evidence & Q&A', 'Versioned evidence contracts, bounded evidence generation, citation paths, intent classification, deterministic ranking, and insufficient-evidence handling.'],
  ['10', 'Engineering Planner', 'Read-only plan synthesis from grounded evidence with affected components, risks, steps, evidence IDs, verification criteria, uncertainties, and contract binding.'],
  ['11', 'Agent Change Contracts', 'A versioned repository-bound artifact binding canonical repository identity, prepared HEAD, paths, components, evidence, verification, architecture expectations, and SHA-256 fingerprint.'],
  ['12', 'Prepare → Change → Verify', 'Prepare establishes the persisted safety boundary. Implementation happens independently. Verify checks the original contract and detects tampering, mismatch, repository changes, and stale HEAD.'],
  ['13', 'Provenance & Decision History', 'Stable provenance IDs, repository HEAD capture, explicit unknown-Git state, prepare/verify provenance, and idempotent architecture decision persistence.'],
  ['14', 'CLI · REST · MCP', 'Local CLI workflows plus Ktor REST and MCP stdio surfaces with path validation, remote-URL rejection, rate limiting, and sanitized public errors where applicable.'],
  ['15', 'Optional AI Assistance', 'Configured Gemini/Anthropic providers can reason over bounded repository-derived context. AI is disabled unless configured and is not repository truth.']
];
---

<BaseLayout title="Capabilities — Vericore" description="Explore the implemented Vericore 0.7.0 engineering intelligence, governance, evidence, planning, and verification capabilities.">
  <section class="hero container"><span class="kicker">VERICORE 0.7.0 / CAPABILITIES</span><h1>One repository.<br /><span>Many engineering signals.</span></h1><p>Vericore connects repository structure, dependencies, Git evolution, changes, architecture, state, evidence, planning, governance, and verification into one local-first engineering intelligence layer.</p></section>
  <section class="container grid">{capabilities.map(([number, title, description]) => (<article class="card"><span class="number">{number}</span><h2>{title}</h2><p>{description}</p></article>))}</section>
  <section class="container principle"><div><span class="kicker">CORE PRINCIPLE</span><h2>Deterministic evidence first.</h2></div><p>Repository-derived facts form the evidence boundary. Engineering Context and Engineering Reality make state explicit. Grounded Q&amp;A and planning consume bounded evidence, while optional AI adds reasoning without becoming the source of repository truth.</p></section>
  <section class="container safety"><div><span class="kicker">CHANGE SAFETY</span><h2>Prepare before you change. Verify what you actually changed.</h2></div><p>The persisted Agent Change Contract is the verification boundary. Verification does not silently reconstruct a replacement contract from a mutable plan after preparation.</p></section>
  <section class="container limits"><div><span class="kicker">CURRENT LIMITS</span><h2>Know the boundaries.</h2></div><ul><li>Analysis currently focuses on Java and Kotlin.</li><li>Kotlin parsing has known complex-syntax limitations.</li><li>The planner is read-only; autonomous source modification is not implemented.</li><li>REST and MCP are trusted local/internal integrations without authentication or tenant isolation.</li><li>Remote repository URLs are not accepted by local server endpoints.</li><li>Architecture contracts are deterministic governance artifacts, not human approval workflows.</li></ul></section>
</BaseLayout>

<style>
  .hero{padding:110px 0 65px;max-width:980px}.kicker{color:var(--accent);font:600 .72rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.12em}.hero h1{margin:18px 0;font-size:clamp(3rem,8vw,6rem);line-height:.96;letter-spacing:-.065em}.hero h1 span{color:var(--muted)}.hero p{max-width:760px;color:var(--muted);font-size:1.15rem}.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.card{min-height:210px;padding:30px;border:1px solid var(--line);border-radius:12px;background:var(--panel);transition:border-color .2s ease,transform .2s ease}.card:hover{border-color:#304155;transform:translateY(-2px)}.number{color:var(--muted);font:.75rem ui-monospace,SFMono-Regular,Menlo,monospace}.card h2{margin:24px 0 10px;font-size:1.35rem;letter-spacing:-.025em}.card p,.principle p,.safety p,.limits li{color:var(--muted);line-height:1.65}.principle,.safety,.limits{margin-top:90px;padding:32px;display:grid;grid-template-columns:1fr 1.4fr;gap:50px;border:1px solid var(--line);border-radius:12px;background:var(--panel)}.principle h2,.safety h2,.limits h2{margin-top:12px;font-size:2rem}.limits ul{margin:0;padding-left:1.2rem}.limits li+li{margin-top:8px}@media(max-width:700px){.grid,.principle,.safety,.limits{grid-template-columns:1fr}.principle,.safety,.limits{gap:10px}}
@media(prefers-reduced-motion:reduce){.card{transition:none}}
</style>
