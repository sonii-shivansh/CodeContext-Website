---
import BaseLayout from '../layouts/BaseLayout.astro';

const capabilities = [
  ['01', 'Repository Intelligence', 'Build a structural model of files, symbols, modules, and relationships so engineers can reason about an unfamiliar repository.'],
  ['02', 'Dependency Intelligence', 'Trace dependency relationships and connected components to expose the surface area behind a proposed change.'],
  ['03', 'Change Intelligence', 'Connect source changes with affected areas and repository evidence so impact is explicit rather than guessed.'],
  ['04', 'PR Intelligence', 'Turn pull-request diffs into structured engineering context for review, risk inspection, and follow-up verification.'],
  ['05', 'Architecture Intelligence', 'Surface architectural relationships and boundaries from repository-derived evidence.'],
  ['06', 'Grounded Evidence', 'Keep higher-level engineering conclusions anchored to identifiable evidence from the analyzed repository.'],
  ['07', 'Repository Q&A', 'Ask questions against repository context and receive answers grounded in the available evidence rather than generic assumptions.'],
  ['08', 'Engineering Planner', 'Transform repository context into structured implementation and verification plans before code changes begin.']
];
---

<BaseLayout title="Capabilities — Vericore" description="Explore the currently implemented Vericore engineering intelligence capabilities.">
  <section class="hero container">
    <span class="kicker">CAPABILITIES</span>
    <h1>One repository.<br /><span>Many engineering signals.</span></h1>
    <p>Vericore connects repository structure, dependencies, changes, architecture, evidence, questions, and planning into one engineering context layer.</p>
  </section>

  <section class="container grid">
    {capabilities.map(([number, title, description]) => (
      <article class="card">
        <span class="number">{number}</span>
        <h2>{title}</h2>
        <p>{description}</p>
      </article>
    ))}
  </section>

  <section class="container principle">
    <div><span class="kicker">DESIGN PRINCIPLE</span><h2>Facts first. Reasoning second.</h2></div>
    <p>Deterministic repository analysis provides the factual substrate. Grounded workflows then use that evidence to produce context, answers, and plans. The website deliberately avoids claiming capabilities that are not present in the implementation.</p>
  </section>
</BaseLayout>

<style>
  .hero { padding: 110px 0 65px; max-width: 980px; }
  .kicker { color: var(--accent); font: 600 .72rem/1.2 ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: .12em; }
  h1 { margin: 18px 0; font-size: clamp(3rem, 8vw, 6rem); line-height: .96; letter-spacing: -.065em; }
  h1 span { color: var(--muted); }
  .hero p { max-width: 720px; color: var(--muted); font-size: 1.15rem; }
  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
  .card { min-height: 230px; padding: 30px; border: 1px solid var(--line); border-radius: 12px; background: var(--panel); transition: border-color .2s ease, transform .2s ease; }
  .card:hover { border-color: #304155; transform: translateY(-2px); }
  .number { color: var(--muted); font: .75rem ui-monospace, SFMono-Regular, Menlo, monospace; }
  h2 { margin: 28px 0 10px; font-size: 1.35rem; letter-spacing: -.025em; }
  .card p, .principle p { color: var(--muted); }
  .principle { margin-top: 90px; padding: 32px; display: grid; grid-template-columns: 1fr 1.4fr; gap: 50px; border: 1px solid var(--line); border-radius: 12px; background: var(--panel); }
  .principle h2 { margin-top: 12px; font-size: 2rem; }
  @media (max-width: 700px) { .grid, .principle { grid-template-columns: 1fr; } .principle { gap: 10px; } }
  @media (prefers-reduced-motion: reduce) { .card { transition: none; } }
</style>
