---
import BaseLayout from '../layouts/BaseLayout.astro';

const docs = [
  ['Getting Started', 'Shortest path from installation to your first local analysis.', 'https://github.com/sonii-shivansh/Vericore/blob/main/docs/GETTING_STARTED.md'],
  ['Architecture', 'System model, package boundaries, evidence flow, and deterministic layers.', 'https://github.com/sonii-shivansh/Vericore/blob/main/docs/ARCHITECTURE.md'],
  ['Engineering Reality', 'How analysis and repository context become a deterministic state identity.', 'https://github.com/sonii-shivansh/Vericore/blob/main/docs/ENGINEERING_REALITY.md'],
  ['Change Safety', 'Prepare, persisted Agent Change Contracts, verification, tamper and stale-state behavior.', 'https://github.com/sonii-shivansh/Vericore/blob/main/docs/CHANGE_SAFETY.md'],
  ['REST API', 'Local Ktor API surface, path boundaries, health endpoints, and request behavior.', 'https://github.com/sonii-shivansh/Vericore/blob/main/docs/API.md'],
  ['MCP / AI Agents', 'Local MCP tools, safety boundary, and persisted change-contract integration.', 'https://github.com/sonii-shivansh/Vericore/blob/main/docs/MCP.md'],
  ['PR Intelligence', 'Pull-request change analysis, risk signals, architecture findings, and evidence.', 'https://github.com/sonii-shivansh/Vericore/blob/main/docs/PR_INTELLIGENCE.md'],
  ['Data & Privacy', 'Local-first data flow, AI provider boundaries, generated artifacts, and limits.', 'https://github.com/sonii-shivansh/Vericore/blob/main/docs/DATA_PRIVACY.md'],
  ['Development', 'Project structure, tests, CI, contributor workflow, and implementation guidance.', 'https://github.com/sonii-shivansh/Vericore/blob/main/docs/DEVELOPMENT.md'],
  ['Implementation Status', 'Implemented capabilities, current limitations, and explicit future direction.', 'https://github.com/sonii-shivansh/Vericore/blob/main/docs/ENTERPRISE_ROADMAP.md'],
  ['Security', 'Security policy and vulnerability reporting guidance.', 'https://github.com/sonii-shivansh/Vericore/blob/main/SECURITY.md']
];
---

<BaseLayout title="Documentation — Vericore" description="Authoritative Vericore 0.7.0 documentation and engineering references.">
  <section class="hero container"><span class="kicker">DOCUMENTATION</span><h1>Read the source of truth.<br /><span>Then inspect the code.</span></h1><p>The website provides navigation and product context. The Vericore repository remains authoritative for implementation details, contracts, schemas, limitations, and current behavior.</p></section>
  <section class="container grid">{docs.map(([title, description, href]) => <a class="card" href={href}><span class="kicker">REFERENCE</span><h2>{title} ↗</h2><p>{description}</p></a>)}</section>
  <section class="container workflow"><span class="kicker">START HERE</span><h2>Choose your path.</h2><div class="paths"><div><strong>New to Vericore</strong><p>Getting Started → Architecture → Change Safety</p></div><div><strong>AI-agent integration</strong><p>Architecture → Engineering Reality → MCP → Change Safety</p></div><div><strong>Security review</strong><p>Data &amp; Privacy → API → MCP → Change Safety</p></div></div></section>
  <section class="container note"><span class="kicker">CURRENT RELEASE</span><h2>Vericore v0.7.0</h2><p>For installation, platform artifacts, checksums, and release notes, use the GitHub release as the authoritative distribution source.</p><a href="https://github.com/sonii-shivansh/Vericore/releases/tag/v0.7.0">View v0.7.0 ↗</a></section>
</BaseLayout>

<style>
  .hero{padding:110px 0 65px;max-width:960px}.kicker{color:var(--accent);font:600 .72rem/1.2 ui-monospace,monospace;letter-spacing:.12em}.hero h1{margin:18px 0;font-size:clamp(3rem,8vw,6rem);line-height:.96;letter-spacing:-.065em}.hero h1 span{color:var(--muted)}.hero p{max-width:720px;color:var(--muted)}.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.card{padding:26px;border:1px solid var(--line);border-radius:12px;background:var(--panel);text-decoration:none}.card:hover{border-color:#304155}.card h2{margin:14px 0 7px;font-size:1.2rem}.card p{margin:0;color:var(--muted)}.workflow{margin-top:70px;padding:30px;border:1px solid var(--line);border-radius:12px;background:var(--panel)}.workflow h2,.note h2{margin:10px 0;font-size:2rem}.paths{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.paths div{padding:18px;border:1px solid var(--line);border-radius:9px;background:var(--panel-2)}.paths p{margin:7px 0 0;color:var(--muted);font-size:.82rem}.note{margin-top:12px;padding:30px;border:1px solid var(--line);border-radius:12px;background:var(--panel)}.note p{color:var(--muted)}.note a{color:var(--accent);text-underline-offset:4px}@media(max-width:700px){.grid,.paths{grid-template-columns:1fr}}
</style>
