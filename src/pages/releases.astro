---
import BaseLayout from '../layouts/BaseLayout.astro';

const releases = [
  ['v0.5.0', 'Engineering Intelligence Foundation', 'Current CodeContext milestone covering repository, change, PR, architecture, evidence, Q&A, and planning capabilities.'],
  ['v0.2.0', 'CodeContext release', 'Previous published release and baseline for the current product line.']
];
---

<BaseLayout title="Releases — CodeContext" description="CodeContext release history and distribution links.">
  <section class="hero container">
    <span class="kicker">RELEASES</span>
    <h1>Shipped,<br /><span>versioned, inspectable.</span></h1>
    <p>Release information is intentionally concise here. GitHub remains the authoritative source for assets, checksums, source archives, and release details.</p>
  </section>
  <section class="container releases">
    {releases.map(([version, title, description]) => (
      <article class="release">
        <div><span class="version">{version}</span><h2>{title}</h2><p>{description}</p></div>
        <a href={`https://github.com/sonii-shivansh/CodeContext/releases/tag/${version}`}>View release ↗</a>
      </article>
    ))}
  </section>
</BaseLayout>

<style>
  .hero { padding: 110px 0 65px; max-width: 900px; }.kicker { color: var(--accent); font: 600 .72rem/1.2 ui-monospace, monospace; letter-spacing: .12em; }
  h1 { margin: 18px 0; font-size: clamp(3rem, 8vw, 6rem); line-height: .96; letter-spacing: -.065em; } h1 span { color: var(--muted); }.hero p { max-width: 700px; color: var(--muted); }
  .releases { display: grid; gap: 10px; }.release { padding: 28px; border: 1px solid var(--line); border-radius: 12px; background: var(--panel); display: flex; justify-content: space-between; align-items: center; gap: 25px; }.version { color: var(--accent); font: .75rem ui-monospace, monospace; }.release h2 { margin: 10px 0 5px; font-size: 1.3rem; }.release p { margin: 0; color: var(--muted); }.release a { white-space: nowrap; text-decoration: none; }.release a:hover { color: var(--accent); }
  @media (max-width: 700px) { .release { flex-direction: column; align-items: flex-start; } }
</style>
