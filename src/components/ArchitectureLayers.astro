---
const layers = [
  ['01', 'Repository', 'Source, Git history, and working-tree state', 'INPUT'],
  ['02', 'Deterministic analysis', 'Structure, dependencies, cycles, PageRank, churn, architecture, evolution', 'FACTS'],
  ['03', 'Context + Reality', 'Versioned context, repository fingerprint, Git HEAD binding, deterministic identity', 'STATE'],
  ['04', 'Evidence', 'Bounded citations and deterministic intelligence for impact, PR, Q&A, tests, and planning', 'GROUNDING'],
  ['05', 'Change boundary', 'Engineering plan plus persisted Agent Change Contract', 'SAFETY'],
  ['06', 'Verification', 'Original prepared artifact checked against the changed repository', 'PROOF'],
] as const;
---

<section class="layers" aria-labelledby="layers-title">
  <div class="heading">
    <span class="kicker">THE BOUNDARY MODEL</span>
    <h2 id="layers-title">Each layer narrows what can be assumed.</h2>
    <p>Vericore does not jump from source code to an AI answer. Evidence is progressively shaped into state, decisions, and a verifiable change boundary.</p>
  </div>
  <ol class="layer-list">
    {layers.map(([number, title, description, label], index) => (
      <li class:list={{ last: index === layers.length - 1 }}>
        <div class="rail" aria-hidden="true"><span>{number}</span></div>
        <div class="card">
          <div class="meta"><span>{label}</span><span>0{index + 1}</span></div>
          <h3>{title}</h3>
          <p>{description}</p>
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .layers{display:grid;grid-template-columns:minmax(260px,.8fr) minmax(0,1.2fr);gap:clamp(32px,6vw,90px);margin-top:90px;padding:clamp(28px,5vw,54px);border:1px solid var(--line);border-radius:14px;background:linear-gradient(145deg,rgba(255,255,255,.04),rgba(255,255,255,.012))}
  .heading{align-self:start;position:sticky;top:96px}.kicker{color:var(--accent);font:600 .72rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.12em}.heading h2{margin:12px 0 10px;font-size:clamp(2rem,4vw,3.2rem);line-height:1.04;letter-spacing:-.04em}.heading p{margin:0;color:var(--muted);line-height:1.7}
  .layer-list{list-style:none;margin:0;padding:0}.layer-list li{display:grid;grid-template-columns:48px 1fr;gap:14px;min-height:112px}.rail{position:relative;display:flex;justify-content:center}.rail::after{content:'';position:absolute;top:36px;bottom:-14px;width:1px;background:var(--line)}.last .rail::after{display:none}.rail span{position:relative;z-index:1;display:grid;place-items:center;width:32px;height:32px;border:1px solid var(--line);border-radius:50%;background:var(--panel);color:var(--accent);font:600 .65rem ui-monospace,monospace}
  .card{padding:18px 20px;border:1px solid var(--line);border-radius:10px;background:var(--panel)}.meta{display:flex;justify-content:space-between;gap:12px;color:var(--muted);font:600 .62rem ui-monospace,monospace;letter-spacing:.1em}.card h3{margin:10px 0 5px;font-size:1rem}.card p{margin:0;color:var(--muted);font-size:.82rem;line-height:1.65}
  @media(max-width:800px){.layers{grid-template-columns:1fr;margin-top:64px}.heading{position:static}.layer-list li{min-height:0;margin-bottom:12px}.rail::after{bottom:-12px}}
  @media(prefers-reduced-motion:reduce){.layer-list *{scroll-behavior:auto}}
</style>
