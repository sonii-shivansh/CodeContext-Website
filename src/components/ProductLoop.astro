---
import { productNarrative } from '../data/productNarrative';
---

<section class="product-loop" aria-labelledby="product-loop-title">
  <div class="intro">
    <p class="eyebrow">THE VERICORE LOOP</p>
    <h2 id="product-loop-title">From repository evidence to a verified change.</h2>
    <p>Vericore keeps engineering reasoning grounded in the state of the repository instead of treating AI output as the source of truth.</p>
  </div>
  <div class="steps">
    {productNarrative.pillars.map((pillar, index) => (
      <article class="step">
        <div class="number" aria-hidden="true">0{index + 1}</div>
        <p class="label">{pillar.label}</p>
        <h3>{pillar.title}</h3>
        <p>{pillar.description}</p>
      </article>
    ))}
  </div>
</section>

<style>
  .product-loop { display:grid; gap:2rem; padding:clamp(2rem,5vw,5rem); border:1px solid var(--line, rgba(255,255,255,.12)); border-radius:28px; background:linear-gradient(145deg, rgba(255,255,255,.055), rgba(255,255,255,.018)); }
  .intro { max-width:760px; }
  .eyebrow,.label { margin:0 0 .65rem; font-size:.75rem; font-weight:800; letter-spacing:.14em; text-transform:uppercase; }
  .intro h2 { margin:.2rem 0 .9rem; max-width:18ch; font-size:clamp(1.8rem,4vw,3.2rem); line-height:1.04; }
  .intro > p:last-child,.step > p:last-child { color:var(--muted,#a8b0bd); line-height:1.7; }
  .steps { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1px; overflow:hidden; border:1px solid var(--line,rgba(255,255,255,.1)); border-radius:20px; background:var(--line,rgba(255,255,255,.1)); }
  .step { min-width:0; padding:clamp(1.2rem,3vw,2rem); background:var(--panel,#0d1117); }
  .number { font:700 .8rem/1 ui-monospace,SFMono-Regular,Menlo,monospace; opacity:.55; }
  .step h3 { margin:.35rem 0 .7rem; font-size:clamp(1.05rem,2vw,1.35rem); }
  @media (max-width:800px) { .steps { grid-template-columns:1fr; } }
</style>
